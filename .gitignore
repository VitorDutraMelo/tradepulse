# ---------------------------------------------------------------
# TradePulse — files that must never be versioned
# ---------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# Environment variables, credentials and private configuration
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials*.json
secrets*.json

# Node.js / frontend and backend
node_modules/
dist/
build/
*.tsbuildinfo

# Manual backups and temporary backup folders
*.bak
*.bak-*
*.orig
*.tmp
.backup-*/
.tradepulse-v2-backup-*/

# Runtime data generated by the engine and the backend
# (signal records, validations, sessions and publication logs).
# Local copies are preserved; they are simply not versioned.
quant-engine/data/**/*.json
quant-engine/data/**/*.jsonl
backend/data/
*.jsonl

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

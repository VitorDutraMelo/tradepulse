@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
:root{font-family:Inter,system-ui,-apple-system,sans-serif;color:#f1f7fa;background:#030b0e;font-synthesis:none}*{box-sizing:border-box}body{margin:0;min-width:320px;background:radial-gradient(ellipse at 50% 0%,#092027 0%,#030b0e 55%)}button{font:inherit;cursor:pointer}button:disabled{opacity:.5;cursor:wait}.shell{max-width:1600px;margin:0 auto;padding:26px 26px 20px}.topbar{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:24px}.brand{display:flex;align-items:center;gap:20px}.brand h1{font-size:42px;line-height:1;margin:0;font-weight:800;letter-spacing:-2px}.brand h1 span{color:#00d85c}.brand p{font-size:17px;color:#a8b9be;margin:7px 0 0}.brandIcon{height:52px;width:60px;display:flex;align-items:flex-end;gap:8px}.brandIcon span{width:11px;background:#00db61;box-shadow:0 0 18px #00db6140}.brandIcon span:nth-child(1){height:29px}.brandIcon span:nth-child(2){height:43px}.brandIcon span:nth-child(3){height:52px}.topright{display:flex;gap:14px;flex-wrap:wrap}.pill{border:1px solid #345058;border-radius:28px;padding:12px 20px;display:flex;align-items:center;gap:10px;font-size:15px;font-weight:700;background:#071216}.pill.status.online{color:#00d963}.pill.status.offline{color:#ffba61}.iq{border-radius:50%;background:#ff8a00;color:white;padding:5px 9px;font-size:18px}.toolbar{display:flex;justify-content:space-between;align-items:center;gap:16px;margin-bottom:18px}.toolbarText p{margin:5px 0 0;color:#849ba3;font-size:13px}.eyebrow{color:#00d767;font-size:11px;letter-spacing:1.8px;font-weight:800}.actions{display:flex;gap:10px}.actions button,.jsonActions button{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:11px 15px;border-radius:10px;font-size:13px;font-weight:700}.primary{background:#00c85a;color:#001d10;border:1px solid #00e569}.secondary{background:#0a1c21;color:#cfe1e5;border:1px solid #294b54}.secondary.selected{border-color:#13824a}.layout{display:grid;grid-template-columns:minmax(320px,.92fr) minmax(0,1.58fr);gap:22px}.panel{background:linear-gradient(135deg,#07171c,#061115);border:1px solid #1e4b55;border-radius:22px;overflow:hidden;box-shadow:0 12px 40px #0003}.signalHero{text-align:center;min-height:275px;padding:22px 18px 26px;background:linear-gradient(150deg,#153f2a,#101b1d);border-bottom:1px solid #28484a}.signalHero.put{background:linear-gradient(145deg,#64141e,#230e16);border-color:#b62939}.signalHero.call{background:linear-gradient(145deg,#0e6b38,#102b20);border-color:#00a950}.signalHero.wait,.signalHero.inactive{background:linear-gradient(145deg,#27353a,#111e23);border-color:#37515a}.signalTitle{font-size:21px;font-weight:800}.signalMain{display:flex;justify-content:center;align-items:center;gap:20px;margin:26px 0 21px}.signalMain strong{font-size:clamp(64px,7vw,100px);letter-spacing:-4px;line-height:1}.signalMain svg{width:100px;height:100px;stroke-width:4;color:#00e26c}.signalHero.put .signalMain svg{color:#ff3948}.signalHero.wait .signalMain svg,.signalHero.inactive .signalMain svg{color:#90a4ab}.signalSubtitle{display:inline-block;border:1px solid currentColor;border-radius:30px;padding:10px 24px;font-size:15px;font-weight:700;color:#d4e8e6}.details{padding:12px 24px 22px}.info{display:grid;grid-template-columns:40% 60%;align-items:center;gap:10px;padding:17px 0;border-bottom:1px solid #1b363d}.info:last-child{border:0}.info span{color:#b5c5ca;font-size:14px}.info strong{font-size:14px;overflow-wrap:anywhere}.rightColumn{display:flex;flex-direction:column;gap:16px}.rightColumn .panel{padding:18px}.rightColumn h2{display:flex;align-items:center;gap:14px;margin:0 0 17px;font-size:21px;letter-spacing:-.6px}.rightColumn h2 svg{color:#00dc65;width:26px;height:26px}.indicatorGrid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.indicator{background:#08171c;border:1px solid #244751;border-radius:14px;min-height:107px;padding:15px 12px 10px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:9px}.indicator span{font-size:15px;font-weight:700}.indicator strong{font-size:20px;overflow-wrap:anywhere}.indicatorLine{width:80%;height:5px;border-radius:9px;margin-top:auto}.reasons ul{list-style:none;padding:0;margin:0;display:grid;gap:12px}.reasons li{display:flex;gap:12px;align-items:flex-start;font-size:15px;line-height:1.5}.reasons li svg{flex-shrink:0;color:#03170d;background:#00d764;border-radius:50%;padding:3px;width:22px;height:22px}.muted{color:#93a7ad}.jsonPanel details summary{cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:10px;font-weight:800;font-size:18px}.jsonPanel details summary>span:first-child{display:flex;gap:12px;align-items:center}.jsonPanel summary svg{color:#00d968}.jsonPanel .muted{font-size:12px;font-weight:500}.jsonActions{display:flex;justify-content:flex-end;margin:18px 0 8px}.jsonPanel pre{font:13px/1.55 Consolas,monospace;background:#041014;border:1px solid #24434a;border-radius:12px;padding:16px;max-height:400px;overflow:auto;color:#b8e4e9;white-space:pre-wrap;overflow-wrap:anywhere}.metadata{display:flex;flex-wrap:wrap;gap:12px 22px;color:#9fb5ba;font-size:12px}.metadata span{display:flex;align-items:center;gap:7px}.error{display:flex;align-items:flex-start;gap:12px;background:#32131b;border:1px solid #bd4054;padding:14px;border-radius:12px;margin-bottom:16px}.error svg{color:#ff6b80;flex-shrink:0}.error p{margin:4px 0 0;font-size:13px}footer{color:#718c93;font-size:12px;line-height:1.7;display:flex;align-items:center;gap:8px;margin-top:22px}.spin{animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}@media(max-width:1000px){.layout{grid-template-columns:1fr}.signalHero{min-height:250px}.info{grid-template-columns:42% 58%}}@media(max-width:650px){.shell{padding:18px 12px}.topbar{align-items:flex-start;flex-direction:column}.brand h1{font-size:32px}.brand p{font-size:13px}.brandIcon{transform:scale(.8);transform-origin:left center;width:48px}.topright{gap:8px}.pill{padding:9px 11px;font-size:12px}.toolbar{flex-direction:column;align-items:stretch}.actions{flex-wrap:wrap}.actions button{flex:1}.rightColumn .panel{padding:14px}.indicatorGrid{grid-template-columns:repeat(2,minmax(0,1fr))}.signalMain strong{font-size:66px}.signalMain svg{width:70px;height:70px}.details{padding:8px 15px}.info{gap:7px}.info span,.info strong{font-size:12px}.rightColumn h2{font-size:18px}.metadata{flex-direction:column}footer{align-items:flex-start}}

.marketSelector {
  display: flex;
  align-items: end;
  flex-wrap: wrap;
  gap: 18px;
  padding: 18px 22px;
  margin-bottom: 20px;
  background: #07171c;
  border: 1px solid #1e4b55;
  border-radius: 16px;
}

.marketField {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.marketField:first-child {
  flex: 1;
  min-width: 230px;
}

.marketField label,
.marketField > span {
  color: #9db4bb;
  font-size: 13px;
  font-weight: 600;
}

.marketField select {
  width: 100%;
  padding: 12px 14px;
  background: #0b2027;
  border: 1px solid #31545c;
  border-radius: 10px;
  color: #f1f7fa;
  font: inherit;
  font-size: 14px;
  cursor: pointer;
}

.marketField select:focus {
  outline: 2px solid #00c85a;
  outline-offset: 2px;
}

.marketField select:disabled {
  opacity: .6;
  cursor: not-allowed;
}

.marketField option {
  background: #0b2027;
  color: #f1f7fa;
}

.marketField option:disabled {
  color: #81949b;
}

.marketOpen {
  color: #00d963;
}

.marketClosed {
  color: #a6b5ba;
}

.marketRefresh {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 12px 16px;
  border-radius: 10px;
  font-size: 13px;
  font-weight: 700;
}

@media (max-width: 650px) {
  .marketSelector {
    flex-direction: column;
    align-items: stretch;
    padding: 14px;
  }

  .marketField:first-child {
    min-width: 0;
  }

  .marketRefresh {
    width: 100%;
  }
}

/* TRADEPULSE - JANELA DE REFERENCIA M1/M5 */

.referenceStatus {
  display: flex;
  align-items: flex-start;
  gap: 13px;
  margin: 16px 20px 0;
  padding: 16px;
  border: 1px solid #31545c;
  border-radius: 12px;
  background: #0b2027;
  color: #d6e5e9;
}

.referenceStatus > svg {
  flex-shrink: 0;
  margin-top: 2px;
}

.referenceStatus strong {
  display: block;
  font-size: 14px;
  line-height: 1.5;
}

.referenceStatus p {
  margin: 5px 0 0;
  color: #a9bec5;
  font-size: 12px;
  line-height: 1.6;
}

.referenceStatus.pending {
  border-color: #b38a30;
  background: #272210;
}

.referenceStatus.pending > svg {
  color: #f3c75b;
}

.referenceStatus.running {
  border-color: #188e59;
  background: #092a1c;
}

.referenceStatus.running > svg {
  color: #00db70;
}

.referenceStatus.expired {
  border-color: #ad4653;
  background: #30151c;
}

.referenceStatus.expired > svg {
  color: #ff7888;
}

.referenceStatus.waiting {
  border-color: #4b6470;
  background: #142329;
}

.referenceStatus.waiting > svg {
  color: #a9bdc6;
}

.referenceStatus.unavailable {
  border-color: #43545b;
  background: #111d22;
}

.referenceStatus.unavailable > svg {
  color: #8da3ab;
}

@media (max-width: 650px) {
  .referenceStatus {
    margin: 12px 12px 0;
    padding: 13px;
  }

  .referenceStatus strong {
    font-size: 13px;
  }

  .referenceStatus p {
    font-size: 12px;
  }
}

/* TRADEPULSE - DASHBOARD MULTIPAINEL */

.dashboardControls {
  justify-content: space-between;
}

.dashboardControls .marketField:first-child {
  flex: 0 1 320px;
}

.dashboardControls .marketField strong {
  color: #e2f2ee;
  font-size: 14px;
}

.multiLayout {
  display: grid;
  gap: 22px;
  align-items: start;
}

.multiLayout.layout-1 {
  grid-template-columns: minmax(0, 1fr);
}

.multiLayout.layout-2,
.multiLayout.layout-4 {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.tradePanel {
  min-width: 0;
  overflow: hidden;
}

.panelControls {
  background: #07171c;
  border: 1px solid #1e4b55;
  border-radius: 16px;
  padding: 17px;
  margin-bottom: 16px;
}

.panelHeading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
  margin-bottom: 15px;
}

.panelHeading > strong {
  color: #f1f7fa;
  font-size: 18px;
}

.queueBadge {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: #132b32;
  color: #b5c9cf;
  border: 1px solid #31545c;
  border-radius: 30px;
  padding: 7px 12px;
  font-size: 12px;
  font-weight: 700;
}

.queueBadge.queueDone {
  color: #00dc69;
  border-color: #137b4b;
  background: #09251a;
}

.queueBadge.queueError {
  color: #ff8a99;
  border-color: #a43c4d;
  background: #30141d;
}

.panelSelects {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.panelSelects .marketField {
  min-width: 0;
}

.panelSelects .marketField:first-child {
  min-width: 0;
}

.panelContent {
  display: grid;
  grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.58fr);
  gap: 18px;
  align-items: start;
}

.tradePanel .signalCard {
  min-width: 0;
}

.tradePanel .signalHero {
  min-height: 230px;
}

.tradePanel .signalMain strong {
  font-size: clamp(46px, 5vw, 86px);
}

.tradePanel .signalMain svg {
  width: clamp(48px, 5vw, 85px);
  height: clamp(48px, 5vw, 85px);
}

.tradePanel .details {
  padding: 12px 18px 20px;
}

.tradePanel .info {
  grid-template-columns: 43% minmax(0, 57%);
  gap: 7px;
  padding: 13px 0;
}

.tradePanel .info span,
.tradePanel .info strong {
  font-size: 12px;
}

.tradePanel .indicatorGrid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.tradePanel .indicator {
  min-width: 0;
  min-height: 100px;
}

.tradePanel .indicator strong {
  font-size: 16px;
}

.tradePanel .rightColumn {
  min-width: 0;
}

.tradePanel .rightColumn h2 {
  font-size: 18px;
}

.tradePanel .rightColumn .panel {
  padding: 15px;
}

.tradePanel .referenceStatus {
  margin: 12px;
}

.panelDisclaimer {
  color: #91a7ad;
  font-size: 12px;
  line-height: 1.7;
  padding: 10px 3px;
}

.multiLayout.layout-1 .panelContent {
  grid-template-columns: minmax(320px, .92fr) minmax(0, 1.58fr);
}

@media (max-width: 1350px) {
  .multiLayout.layout-2,
  .multiLayout.layout-4 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .multiLayout.layout-2 .panelContent,
  .multiLayout.layout-4 .panelContent {
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (max-width: 900px) {
  .multiLayout.layout-1 .panelContent {
    grid-template-columns: minmax(0, 1fr);
  }

  .multiLayout.layout-2,
  .multiLayout.layout-4 {
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (max-width: 650px) {
  .panelSelects {
    grid-template-columns: minmax(0, 1fr);
  }

  .dashboardControls .marketField:first-child {
    flex: 1;
  }

  .tradePanel .signalMain strong {
    font-size: 60px;
  }

  .tradePanel .signalMain svg {
    width: 60px;
    height: 60px;
  }

  .tradePanel .info span,
  .tradePanel .info strong {
    font-size: 12px;
  }
}

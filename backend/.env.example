NODE_ENV=development

# The API only binds to loopback (127.0.0.1, ::1 or localhost). Any other
# value is rejected at startup: see docs/SECURITY.md before exposing it.
HOST=127.0.0.1
PORT=3001

# Comma-separated list of allowed browser origins (GET only).
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

QUANT_ENGINE_PYTHON=../quant-engine/.venv/Scripts/python.exe
QUANT_ENGINE_WORKING_DIRECTORY=../quant-engine
# Timeout of the legacy one-shot CLI endpoints (Binance, local history).
QUANT_ENGINE_TIMEOUT_MS=15000

# --- IQ Option PRACTICE credentials --------------------------------------
# Read only by the gateway worker. Never commit real values, never paste
# them in the frontend, logs or screenshots. Prefer setting them in the
# terminal session instead of this file:
#   $env:IQ_OPTION_DEMO_EMAIL="..."; $env:IQ_OPTION_DEMO_PASSWORD="..."
IQ_OPTION_DEMO_EMAIL=
IQ_OPTION_DEMO_PASSWORD=

# --- Persistent IQ gateway (blocks A.1/A.2) --------------------------------
IQ_GATEWAY_REQUEST_TIMEOUT_MS=45000
IQ_GATEWAY_MAX_QUEUE=16
IQ_GATEWAY_RESTART_BACKOFF_MAX_MS=30000
# Read by the Python worker:
IQ_GATEWAY_BACKOFF_BASE_SECONDS=1
IQ_GATEWAY_BACKOFF_MAX_SECONDS=60
IQ_GATEWAY_CANDLE_TIMEOUT_SECONDS=12
IQ_GATEWAY_MIN_REFETCH_SECONDS=1

IQ_LIVE_MAX_SUBSCRIPTIONS=8
IQ_LIVE_SUBSCRIPTION_TTL_MS=600000

# Provisional, experimental publication tolerances (not approved rules).
SIGNAL_TOLERANCE_M1_MS=10000
SIGNAL_TOLERANCE_M5_MS=30000

# Local JSON-lines log of every publication (git-ignored). Empty = disabled.
PUBLICATION_LOG_PATH=data/runtime/publications.jsonl
